        "var": "sum",
        "expr": "0"
      },
      {
        "kind": "FOR",
        "var": "i",
        "from": "1",
        "bound": "5",
        "cmp": "<=",
        "body": [
          {
            "kind": "ASSIGN",
            "var": "sum",
            "expr": "sum + i"
          }
        ]
      },
      {
        "kind": "OUTPUT",
        "expr": "sum"
      }

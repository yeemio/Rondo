{
  "taskId": "cpp.u1.i2.enum-count.v1",
  "taskFamily": "cpp.steps.v1",
  "kind": "INDEPENDENT",
  "title": "清点 4 的倍数",
  "prompt": [
    {
      "type": "TEXT",
      "text": "清点 1 到 40 号商品里，编号是 4 的倍数的有几件。程序已经搭好了循环和计数，但判断条件写错了。"
    },
    {
      "type": "TEXT",
      "text": "先口算猜一个数（记录不判分），再把条件修对，让程序逐个编号检查。"
    },
    {
      "type": "TEXT",
      "text": "注意：提交后服务端还会换编号范围复跑（比如数 1..4，甚至 1..0）。"
    }
  ],
  "givens": {
    "inputs": {
      "n": 40
    },
    "program": [
      {
        "kind": "ASSIGN",
        "var": "count",
        "expr": "0"
      },
      {
        "kind": "FOR",
        "var": "i",
        "from": "1",
        "bound": "n",
        "cmp": "<=",
        "body": [
          {
            "kind": "IF",
            "cond": "i % 4 == 4",
            "then": [
              {
                "kind": "ASSIGN",
                "var": "count",
                "expr": "count + 1"
              }
            ],
            "else": []
          }
        ]
      },
      {
        "kind": "OUTPUT",
        "expr": "count"
      }
    ],
    "cursorStep": 0
  },

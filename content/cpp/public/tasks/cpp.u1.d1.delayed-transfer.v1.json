{
  "taskId": "cpp.u1.d1.delayed-transfer.v1",
  "taskFamily": "cpp.steps.v1",
  "kind": "DELAYED_TRANSFER",
  "title": "储物室里藏 7 的柜子（延迟迁移）",
  "prompt": [
    {
      "type": "TEXT",
      "text": "储物室的柜子编号从 lo 到 hi（现在是 260 到 299）。要数编号里含有数字 7 的柜子：十位是 7，或者个位是 7。"
    },
    {
      "type": "FORMULA",
      "expression": "十位：i / 10 % 10；个位：i % 10；满足任意一个就算：||"
    },
    {
      "type": "TEXT",
      "text": "卡里的条件只查了十位。把它补成「十位是 7 或个位是 7」。先口算猜一个数（记录不判分），再改对提交。"
    }
  ],
  "givens": {
    "inputs": {
      "lo": 260,
      "hi": 299
    },
    "program": [
      {
        "kind": "ASSIGN",
        "var": "count",
        "expr": "0"
      },
      {
        "kind": "FOR",
        "var": "i",
        "from": "lo",
        "bound": "hi",
        "cmp": "<=",
        "body": [
          {
            "kind": "IF",
            "cond": "i / 10 % 10 == 7",
            "then": [
              {
                "kind": "ASSIGN",
                "var": "count",
                "expr": "count + 1"
              }
            ],
            "else": []
          }
        ]
      },
      {
        "kind": "OUTPUT",
        "expr": "count"
      }
    ],
    "cursorStep": 0
  },
  "givenLocks": [],

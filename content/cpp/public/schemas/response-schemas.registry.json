      "schemaId": "resp.cpp.u1.trace.v1",
      "summary": "g1 顺序与变量重赋值：预测输出行 + 旧值/新值概念",
      "predict": {
        "asks": [
          {
            "id": "ask.g1.output",
            "kind": "outputLines",
            "prompt": "预测：这张卡会输出什么？（每行一个数）",
            "optionalUncertain": true,
            "maxLines": 8
          },
          {
            "id": "ask.g1.total-old-new",
            "kind": "choice",
            "prompt": "第 4 步「total := total + 4」右边的 total 用的是旧值还是新值？",
            "options": [
              {
                "id": "opt-old",
                "label": "旧值（先算右边再覆盖）"
              },
              {
                "id": "opt-new",
                "label": "新值"
              },
              {
                "id": "opt-unsure",
                "label": "不确定"
              }
            ]
          }
        ]
      },
      "verify": {
        "items": [
          {
            "kind": "outputString",
            "quantityId": "output",
            "prompt": "现在这张卡（完成改动后）的输出是？每行一个数。",
            "maxLines": 8
          },
          {
            "kind": "finalVariables",
            "prompt": "结束时各变量的值是？",
            "variables": [
              {
                "id": "a",
                "label": "a"
              },
              {
                "id": "b",
                "label": "b"
              },
              {
                "id": "total",
                "label": "total"
              }
            ]
          },
          {
            "kind": "singleChoice",
            "selectionId": "sel.g1.total-old-new",
            "prompt": "「total := total + 4」右边的 total 用的是？",
            "options": [
              {
                "id": "opt-old",
                "label": "旧值：右边先算完，再覆盖左边的变量"

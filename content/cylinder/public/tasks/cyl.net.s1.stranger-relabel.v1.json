  "hints": [
    {
      "level": 1,
      "label": "重述题意",
      "text": "贴纸只包瓶身侧面。已知底面直径 3.0 cm、贴纸高 9.0 cm。四问：半径；四条边配对；哪条边成圆周/成高；贴纸面积（两位小数+单位）。"
    },
    {
      "level": 2,
      "label": "概念提示",
      "text": "贴纸只包侧面；摊开后是长方形，它的边和瓶身上的线一一对应。"
    },
    {
      "level": 3,
      "label": "策略提示",
      "text": "先用直径算半径（r=d÷2），再算 C=2πr，再乘贴纸的高；配对可以回卷一小段验证。"
    },
    {
      "level": 4,
      "label": "答案级提示"
    }

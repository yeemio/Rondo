  "hints": [
    {
      "level": 1,
      "label": "重述题意",
      "text": "底罐 r=3.0、h=8.0；甲只把 h 加倍到 16.0；乙只把 r 加倍到 6.0。答哪个装得多、各多少、半径加倍体积几倍；最后换小罐再试。"
    },
    {
      "level": 2,
      "label": "概念提示",
      "text": "底面是一个圆——半径加倍，圆面积不是加倍；高只是乘法里的一个乘数。"
    },
    {
      "level": 3,
      "label": "策略提示",
      "text": "分别算两个底面积（π×3×3 和 π×6×6），各乘自己的高，再比大小。"
    },
    {
      "level": 4,
      "label": "答案级提示"
    }
  ],

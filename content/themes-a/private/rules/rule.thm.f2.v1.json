      "thm.f2.g1.scale-bar.v1": {
        "checks": [
          {
            "id": "c1",
            "kind": "fraction",
            "quantityId": "scaled-fraction",
            "label": "同乘后的分数",
            "source": {
              "kind": "FROM_STATE"
            },
            "comparison": {
              "kind": "EXACT"
            }
          },
          {
            "id": "c2",
            "kind": "choice",
            "label": "涂色大小是否变化",
            "selectionId": "sel.size-change",
            "correctOptionId": "opt-same-size"
          },
          {
            "id": "c3",
            "kind": "choice",
            "label": "相等的原因",
            "selectionId": "sel.why-equal",
            "correctOptionId": "opt-both-scaled"
          }
        ],
        "scenario": {
          "kind": "GRID_AT",
          "cols": 4,
          "filled": 2
        },
        "scenarioFeedback": "请先做一次\"同乘 2\"并确认，再提交。",
        "diagnostics": [
          {
            "tag": "mis-numerator-only-scaled",
            "checkId": "c1",
            "when": {
              "kind": "FRACTION_NUMERATOR_ONLY_SCALED",
              "preNumerator": 1,
              "preDenominator": 2,
              "multiplier": 2
            },
            "feedback": "再看看：只有分子乘了 2，分母也要乘同一个数——同乘要\"一起\"。"
          },
          {
            "tag": "mis-denominator-only-scaled",
            "checkId": "c1",
            "when": {
              "kind": "FRACTION_DENOMINATOR_ONLY_SCALED",
              "preNumerator": 1,
              "preDenominator": 2,
              "multiplier": 2
            },
            "feedback": "再看看：只有分母乘了 2，分子也要乘同一个数——同乘要\"一起\"。"
          }
        ],
        "reveal": [
          {
            "checkId": "c1",
            "text": "分子分母同乘 2：1/2 → 2/4。"
          },
          {
            "checkId": "c2",
            "text": "大小不变——涂的还是同一半。"
          },
          {
            "checkId": "c3",
            "text": "分子分母乘了同一个数，分数大小不变。"
          }
        ],
        "feedback": {
          "reviseGeneric": "再看一遍图：同乘只是把每份切细，涂色的长短没变。"
        }
      },

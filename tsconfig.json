{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.cts",
    "apps/**/*.tsx",
    "apps/**/*.d.ts",
    "modules/**/*.ts",
    "modules/**/*.tsx",
    "adapters/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
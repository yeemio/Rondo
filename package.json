    "build:tests:storage": "esbuild tests/storage/*.test.ts --bundle --platform=node --format=esm --outdir=dist/tests/storage --out-extension:.js=.mjs --loader:.sql=text --log-level=warning",
    "build:tests:integration": "esbuild tests/integration/*.test.ts --bundle --platform=node --format=esm --outdir=dist/tests/integration --out-extension:.js=.mjs --loader:.sql=text --log-level=warning",
    "test:content": "esbuild tests/content/*.test.ts --bundle --platform=node --format=esm --outdir=dist/tests/content --out-extension:.js=.mjs --loader:.sql=text --log-level=warning && node --test \"dist/tests/content/*.test.mjs\"",
    "test:scenes": "esbuild tests/scenes/scenes.test.ts --bundle --platform=node --format=esm --outfile=dist/tests/scenes/scenes.test.mjs --log-level=warning && node --test dist/tests/scenes/scenes.test.mjs",

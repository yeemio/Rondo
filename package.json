    "test:domain": "npm run build:tests:domain && node --test \"dist/tests/domain/*.test.mjs\"",
    "test:storage": "npm run build:tests:storage && node --test \"dist/tests/storage/*.test.mjs\"",
    "test:integration": "npm run build:tests:integration && node --test \"dist/tests/integration/*.test.mjs\"",
    "test:b": "npm run typecheck && npm run test:domain && npm run test:storage && npm run test:integration",
    "check:all": "npm run typecheck && npm run check:contracts && npm run test:desktop && npm run test:domain && npm run test:storage && npm run test:integration && npm run test:content && npm run test:scenes && npm run test:learning-flow && npm run test:themes && npm run test:cpp && npm run check:boundaries",
    "test:themes": "esbuild tests/themes/*.test.ts --bundle --platform=node --format=esm --outdir=dist/tests/themes --out-extension:.js=.mjs --loader:.sql=text --log-level=warning && node --test \"dist/tests/themes/*.test.mjs\"",
    "test:cpp": "esbuild tests/cpp/*.test.ts --bundle --platform=node --format=esm --outdir=dist/tests/cpp --out-extension:.js=.mjs --loader:.sql=text --log-level=warning && node --test \"dist/tests/cpp/*.test.mjs\""
